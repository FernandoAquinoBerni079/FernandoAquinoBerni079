Algoritmo PrecioMedio
    Definir cantCuad, cantBol, unidades, total Como Entero
    Definir medio Como Real
    Leer cantCuad
    Leer cantBol
    total <- cantCuad * 8000 + cantBol * 3000
    unidades <- cantCuad + cantBol
    medio <- total / unidades
    Escribir "Precio medio por artículo: ", medio
FinAlgoritmo
