Algoritmo VectorPrecios
    Definir precios, i Como Entero
    Dimension precios[7]
    Para i <- 1 Hasta 7 Con Paso 1 Hacer
        Escribir "Precio del artículo ", i, ":"
        Leer precios[i]
    FinPara
    Escribir "Artículo 5: ", precios[5]
    Escribir "Primero y último: ", precios[1], " y ", precios[7]
FinAlgoritmo
